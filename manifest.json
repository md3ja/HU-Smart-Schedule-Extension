{
  "manifest_version": 3,
  "name": "HU Smart Schedule",
  "version": "1.0.1",
  "description": "يعرض شعب مواد الجامعة الهاشمية ويقترح جداول بدون تعارض حسب الوقت والأيام.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://hu.edu.jo/*"
  ],
  "action": {
    "default_title": "HU Smart Schedule",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  }
}
